graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef structBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    classDef decisionBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:center,font-family:monospace;

    Schema["Actor<br/>BaseModel<br/>├─ name: str<br/>└─ film_names: list[str]"]:::schemaBlock

    LLM["llm = init_chat_model(<br/>    'openai:gpt-4.1-mini',<br/>    temperature=0<br/>)"]:::codeBlock

    Structured["llm.with_structured_output(<br/>    Actor,<br/>    include_raw=True<br/>)"]:::structBlock

    Query["actor_query =<br/>'Generate the filmography for a random actor.'"]:::codeBlock

    Exec["checked = llm.with_structured_output(<br/>    Actor,<br/>    include_raw=True<br/>).invoke(actor_query)"]:::execBlock

    Checked["checked : dict<br/>├─ raw<br/>├─ parsed<br/>└─ parsing_error"]:::resultBlock

    Decision{"checked['parsing_error']<br/>is None?"}:::decisionBlock

    Success["성공 경로<br/>print('성공:', checked['parsed'])<br/><br/>checked['parsed']<br/>└─ Actor 객체"]:::resultBlock

    Failure["실패 경로<br/>print('실패:', checked['parsing_error'])<br/>checked['raw'].text"]:::execBlock

    Recover["parse_or_fix(checked['raw'].text)<br/>└─ parser.parse() 재시도<br/>└─ 필요 시 fixer.invoke(...) 복구"]:::execBlock

    Fixed["복구된 Actor 객체"]:::resultBlock

    LLM == "1. 원본 LLM" ==> Structured
    Schema == "2. Actor 스키마 + include_raw 설정" ==> Structured
    Structured -. "invoke()에 사용" .-> Exec
    Query == "3. actor_query 입력" ==> Exec
    Exec == "4. raw/parsed/error 묶음 반환" ==> Checked
    Checked ==> Decision
    Decision == "Yes" ==> Success
    Decision == "No" ==> Failure
    Failure == "5. 원본 텍스트를 복구 함수에 전달" ==> Recover
    Recover == "6. fallback 복구" ==> Fixed
