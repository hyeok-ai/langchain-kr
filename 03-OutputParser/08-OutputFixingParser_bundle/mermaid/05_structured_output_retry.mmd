graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef structBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Schema["Actor<br/>BaseModel<br/>├─ name: str<br/>└─ film_names: list[str]"]:::schemaBlock

    LLM["llm = init_chat_model(<br/>    'openai:gpt-4.1-mini',<br/>    temperature=0<br/>)"]:::codeBlock

    Structured["llm.with_structured_output(Actor)"]:::structBlock

    Retry[".with_retry(<br/>    stop_after_attempt=3<br/>)<br/><br/>일시적 실행 오류 시 최대 3회 시도"]:::structBlock

    Runnable["structured_actor =<br/>llm.with_structured_output(Actor)<br/>   .with_retry(stop_after_attempt=3)"]:::chainBlock

    Query["actor_query =<br/>'Generate the filmography for a random actor.'"]:::codeBlock

    Exec["structured_actor.invoke(actor_query)"]:::execBlock

    Result["검증된 Actor 객체"]:::resultBlock

    LLM == "1. 원본 LLM" ==> Structured
    Schema == "2. Actor 스키마 설정" ==> Structured
    Structured == "3. 구조화 출력 Runnable" ==> Retry
    Retry == "4. retry 래퍼 적용" ==> Runnable
    Runnable -. "조립된 Runnable" .-> Exec
    Query == "5. invoke() 입력" ==> Exec
    Exec == "6. 구조화 출력 반환" ==> Result
