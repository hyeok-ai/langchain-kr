    Bad["misformatted =<br/>'{'name': 'Tom Hanks',<br/>  'film_names': ['Forrest Gump']}'"]:::codeBlock

    Literal["ast.literal_eval(misformatted)<br/><br/>문자열의 Python 리터럴만 안전하게 해석"]:::execBlock

    Dict["Python dict<br/>{<br/>  'name': 'Tom Hanks',<br/>  'film_names': ['Forrest Gump']<br/>}"]:::resultBlock

    Schema["Actor.model_validate(...)<br/><br/>Actor 스키마:<br/>├─ name: str<br/>└─ film_names: list[str]"]:::schemaBlock

