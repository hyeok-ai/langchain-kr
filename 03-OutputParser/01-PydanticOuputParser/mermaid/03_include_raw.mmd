graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef structBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Schema["EmailSummary<br/><br/>BaseModel<br/>├─ person: str<br/>├─ email: str<br/>├─ subject: str<br/>├─ summary: str<br/>└─ date: str"]:::schemaBlock

    LLM["llm<br/>└─ init_chat_model(<br/>    'openai:gpt-5.6-luna',<br/>    temperature=0<br/>)"]:::codeBlock

    Structured["llm.with_structured_output(<br/>    EmailSummary,<br/>    include_raw=True<br/>)"]:::structBlock

    Prompt["prompt<br/>└─ ChatPromptTemplate.from_messages([...])<br/><br/>변수 구멍:<br/>├─ {question}<br/>└─ {email_conversation}"]:::codeBlock

    Chain["chain_with_raw = prompt<br/>    | llm.with_structured_output(<br/>        EmailSummary,<br/>        include_raw=True<br/>      )"]:::chainBlock

    Exec["result = chain_with_raw.invoke({<br/>    'email_conversation': email_conversation,<br/>    'question': '이메일 내용중 주요 내용을 추출해 주세요.'<br/>})"]:::execBlock

    Result["result : dict"]:::resultBlock
    Raw["result['raw']<br/>└─ 원본 AIMessage<br/>   └─ usage_metadata"]:::resultBlock
    Parsed["result['parsed']<br/>└─ EmailSummary 객체"]:::resultBlock
    Error["result['parsing_error']<br/>└─ 오류 또는 None"]:::resultBlock

    LLM == "1. 원본 LLM" ==> Structured
    Schema == "2. 구조화 스키마 설정" ==> Structured
    Prompt == "3. Prompt 객체 결합" ==> Chain
    Structured == "4. include_raw 구조화 LLM 결합" ==> Chain
    Chain -. "조립된 체인" .-> Exec
    Exec == "5. dict 형태 결과" ==> Result
    Result ==> Raw
    Result ==> Parsed
    Result ==> Error
