graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef parserBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;
    classDef promptBlock fill:#1e1e1e,color:#d4d4d4,stroke:#9cdcfe,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Schema["EmailSummary<br/>BaseModel<br/>├─ person<br/>├─ email<br/>├─ subject<br/>├─ summary<br/>└─ date"]:::schemaBlock

    Parser["parser = PydanticOutputParser(<br/>    pydantic_object=EmailSummary<br/>)"]:::parserBlock

    Format["parser.get_format_instructions()<br/><br/>→ 모델에게 보여 줄<br/>JSON 출력 형식 지침 문자열"]:::parserBlock

    PromptBase["ChatPromptTemplate.from_template(<br/>'''You are a helpful assistant. Please answer the following questions in KOREAN.<br/><br/>QUESTION:<br/>{question}<br/><br/>EMAIL CONVERSATION:<br/>{email_conversation}<br/><br/>FORMAT:<br/>{format}<br/>'''<br/>)"]:::promptBlock

    Prompt["legacy_prompt = (...)<br/>    .partial(<br/>        format=parser.get_format_instructions()<br/>    )<br/><br/>남은 실행 시 변수:<br/>├─ {question}<br/>└─ {email_conversation}<br/><br/>{format}은 이미 채워짐"]:::promptBlock

    LLM["llm = init_chat_model(...)"]:::codeBlock

    Chain["legacy_chain =<br/>legacy_prompt | llm | parser"]:::chainBlock

    Exec["legacy_chain.invoke({<br/>    'email_conversation': email_conversation,<br/>    'question': '이메일 내용중 주요 내용을 추출해 주세요.'<br/>})"]:::execBlock

    LLMText["LLM 출력<br/>└─ 먼저 JSON 형태의 텍스트 생성"]:::resultBlock
    Result["parser가 텍스트를 읽고 검증<br/>↓<br/>EmailSummary 객체"]:::resultBlock

    Schema == "1. Pydantic 스키마를 Parser에 설정" ==> Parser
    Parser == "2. 형식 지침 문자열 생성" ==> Format
    PromptBase == "3. 원본 PromptTemplate" ==> Prompt
    Format -. "4. partial()로 {format} 미리 채움" .-> Prompt
    Prompt == "5. Prompt 객체 결합" ==> Chain
    LLM == "6. LLM 객체 결합" ==> Chain
    Parser == "7. 출력 Parser 객체 결합" ==> Chain
    Chain -. "조립된 legacy_chain" .-> Exec
    Exec == "8. 내부에서 Prompt → LLM" ==> LLMText
    LLMText == "9. 문자열 → Parser" ==> Result

    Schema ~~~ LLM
