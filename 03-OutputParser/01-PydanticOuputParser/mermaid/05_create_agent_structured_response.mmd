graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef agentBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Schema["EmailSummary<br/>└─ BaseModel 구조화 출력 스키마"]:::schemaBlock

    LLM["llm<br/>└─ init_chat_model(<br/>    'openai:gpt-5.6-luna',<br/>    temperature=0<br/>)"]:::codeBlock

    Tools["tools = []<br/>└─ 현재 예제에서는 Tool 없음"]:::codeBlock

    System["system_prompt =<br/>'이메일에서 주요 정보를 추출하는 어시스턴트입니다.<br/>모든 값은 한국어로 작성하세요.'"]:::codeBlock

    Agent["agent = create_agent(<br/>    model=llm,<br/>    tools=[],<br/>    system_prompt='...',<br/>    response_format=EmailSummary<br/>)"]:::agentBlock

    Input["{<br/>  'messages': [<br/>    {<br/>      'role': 'user',<br/>      'content': email_conversation<br/>    }<br/>  ]<br/>}"]:::codeBlock

    Exec["result = agent.invoke(<br/>    {<br/>      'messages': [<br/>        {'role': 'user', 'content': email_conversation}<br/>      ]<br/>    }<br/>)"]:::execBlock

    Result["result<br/>└─ Agent 실행 결과 dict"]:::resultBlock
    Structured["result['structured_response']<br/>└─ EmailSummary 객체"]:::resultBlock

    LLM == "1. model 파라미터" ==> Agent
    Tools == "2. tools 파라미터" ==> Agent
    System == "3. system_prompt 파라미터" ==> Agent
    Schema == "4. response_format 파라미터" ==> Agent
    Agent -. "완성된 Agent 객체" .-> Exec
    Input == "5. invoke() 시 messages 전달" ==> Exec
    Exec == "6. Agent 결과 반환" ==> Result
    Result == "7. 구조화된 최종 응답" ==> Structured
