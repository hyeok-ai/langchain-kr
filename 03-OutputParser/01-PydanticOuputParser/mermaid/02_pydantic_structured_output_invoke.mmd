graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef structBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Schema["class EmailSummary(BaseModel):<br/>    '''이메일에서 추출한 핵심 정보'''<br/>    person: str = Field(description='메일을 보낸 사람')<br/>    email: str = Field(description='메일을 보낸 사람의 이메일 주소')<br/>    subject: str = Field(description='메일 제목')<br/>    summary: str = Field(description='메일 본문을 요약한 텍스트')<br/>    date: str = Field(description='메일 본문에 언급된 미팅 날짜와 시간')"]:::schemaBlock

    LLM["llm = init_chat_model(<br/>    'openai:gpt-5.6-luna',<br/>    temperature=0<br/>)"]:::codeBlock

    StructLLM["structured_llm =<br/>    llm.with_structured_output(<br/>        EmailSummary<br/>    )"]:::structBlock

    Prompt["prompt = ChatPromptTemplate.from_messages([<br/>    ('system', 'You are a helpful assistant. 모든 값은 한국어로 작성하세요.'),<br/>    ('human', '{question}\\n\\nEMAIL CONVERSATION:\\n{email_conversation}')<br/>])"]:::codeBlock

    Chain["chain = prompt | structured_llm"]:::chainBlock

    Data["email_conversation<br/><br/>question =<br/>'이메일 내용중 주요 내용을 추출해 주세요.'"]:::codeBlock

    Exec["response = chain.invoke({<br/>    'email_conversation': email_conversation,<br/>    'question': '이메일 내용중 주요 내용을 추출해 주세요.'<br/>})"]:::execBlock

    Response["response : EmailSummary<br/><br/>response.person<br/>response.email<br/>response.subject<br/>response.summary<br/>response.date"]:::resultBlock

    LLM == "1. 원본 LLM" ==> StructLLM
    Schema == "2. 스키마를 LLM에 설정" ==> StructLLM
    Prompt == "3. Prompt 객체 결합" ==> Chain
    StructLLM == "4. 구조화 출력 LLM 객체 결합" ==> Chain
    Chain -. "조립된 체인" .-> Exec
    Data == "5. invoke() 시 두 변수 주입" ==> Exec
    Exec == "6. 검증된 Pydantic 객체 반환" ==> Response

    Schema ~~~ LLM
