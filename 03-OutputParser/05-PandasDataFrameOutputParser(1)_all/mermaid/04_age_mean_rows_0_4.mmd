graph TD
    classDef titleBlock fill:transparent,color:#111,stroke:transparent,font-size:24px,font-weight:bold;
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    classDef funcBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;

    Title["<span style='white-space:nowrap'>04. 0~4행 Age 평균: 구조화 계획 → pandas mean()</span>"]:::titleBlock
    Input["{'question': 'Retrieve the average of the Ages from row 0 to 4.'}"]:::codeBlock
    Query["query_chain = plan_chain | RunnableLambda(lambda q: run_query(df, q))"]:::chainBlock
    Exec["result = query_chain.invoke({<br/>'question': 'Retrieve the average of the Ages from row 0 to 4.'<br/>})"]:::execBlock

    PlanResult["DataFrameQuery 계획 객체<br/>(질문의 의도상)<br/>operation = 'mean'<br/>column = 'Age'<br/>row_start = 0<br/>row_end = 4"]:::resultBlock

    Slice["run_query(df, q)<br/>start = 0<br/>stop = 4 + 1 → 5<br/>subset = df.iloc[0:5]<br/>series = subset['Age']"]:::funcBlock
    TypeCheck["if not pd.api.types.is_numeric_dtype(series):<br/>raise ValueError(...)<br/><br/>Age는 숫자형이면 계속 진행"]:::funcBlock
    Calc["return getattr(series, q.operation)()<br/>→ getattr(series, 'mean')()<br/>→ series.mean()"]:::funcBlock
    Result["result<br/>→ LLM 계획을 코드가 실행한 평균값"]:::resultBlock

    Verify["직접 계산 검증:<br/>df['Age'].head().mean()"]:::codeBlock
    Compare["print('LLM 계획 기반 결과:', result)<br/>print('직접 계산 검증   :', df['Age'].head().mean())"]:::resultBlock

    Title ~~~ Input
    Input == "1. query_chain.invoke()에 질문 주입" ==> Exec
    Query -. "조립된 query_chain" .-> Exec
    Exec == "2. 내부 plan_chain이 DataFrameQuery 생성" ==> PlanResult
    PlanResult == "3. RunnableLambda의 q" ==> Slice
    Slice == "4. Age Series 선택" ==> TypeCheck
    TypeCheck == "5. 숫자형 확인" ==> Calc
    Calc == "6. 평균 반환" ==> Result
    Result == "7. 출력" ==> Compare
    Verify == "독립적인 pandas 계산" ==> Compare
