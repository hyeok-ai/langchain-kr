graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef structBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Schema["AnswerWithSource(TypedDict)<br/>├─ answer: Annotated[str, ..., '사용자의 질문에 대한 답변']<br/>└─ source: Annotated[str, ..., '출처 또는 웹사이트주소']"]:::schemaBlock

    Prompt["prompt = ChatPromptTemplate.from_messages([<br/>    ('system', 'answer the users question as best as possible.'),<br/>    ('human', '{question}'),<br/>])"]:::codeBlock

    LLM["llm = init_chat_model(<br/>    'openai:gpt-4.1-mini',<br/>    temperature=0<br/>)"]:::codeBlock

    Struct["llm.with_structured_output(<br/>    AnswerWithSource<br/>)"]:::structBlock

    Chain["chain = prompt |<br/>        llm.with_structured_output(AnswerWithSource)<br/><br/>※ 앞 셀에서 만든 같은 chain 재사용"]:::chainBlock

    Exec["for s in chain.stream({<br/>    'question': '세종대왕의 업적은 무엇인가요?'<br/>}):<br/>    print(s)"]:::execBlock

    Partial1["s : partial dict<br/>{'answer': ...}"]:::resultBlock
    Partial2["s : partial dict<br/>{'answer': ..., 'source': ...}"]:::resultBlock

    Schema == "1. 스키마" ==> Struct
    LLM == "2. 원본 LLM" ==> Struct
    Prompt == "3. Prompt 객체" ==> Chain
    Struct == "4. 구조화 출력 LLM" ==> Chain
    Chain -. "같은 chain 재사용" .-> Exec
    Exec == "5. stream()에서 부분 dict 순차 반환" ==> Partial1
    Partial1 -. "다음 부분 결과" .-> Partial2
