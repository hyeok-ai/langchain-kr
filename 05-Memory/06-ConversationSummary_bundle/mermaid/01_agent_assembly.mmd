title: 1. 모델 · SummarizationMiddleware · Checkpointer → Agent 조립
---
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace;
    classDef middlewareBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef stateBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    classDef agentBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:3px,text-align:left,font-family:"Noto Sans Mono CJK KR",monospace,font-size:16px;

    Env["MODEL_ID = os.getenv(<br/>    'CHAT_MODEL',<br/>    'openai:gpt-5.6-luna'<br/>)"]:::codeBlock
    Model["model = init_chat_model(MODEL_ID)"]:::codeBlock

    Middleware["SummarizationMiddleware(<br/>    model=model,<br/>    trigger=('messages', 8),<br/>    keep=('messages', 4),<br/>)"]:::middlewareBlock

    Checkpointer["InMemorySaver()"]:::stateBlock

    Agent["summary_agent = create_agent(<br/>    model=model,<br/>    tools=[],<br/>    system_prompt=(<br/>        '당신은 여행 상품 상담원입니다. '<br/>        '가격·포함 사항·취소 조건을 정확히 기억하고 '<br/>        '모르는 내용은 추측하지 마세요.'<br/>    ),<br/>    middleware=[SummarizationMiddleware(...)],<br/>    checkpointer=InMemorySaver(),<br/>)"]:::agentBlock

    Config["config = {<br/>    'configurable': {<br/>        'thread_id': 'europe-package'<br/>    }<br/>}"]:::stateBlock

    Env == "1. 모델 ID 결정" ==> Model
    Model == "2. Agent의 model" ==> Agent
    Model == "3. 요약용 model도 재사용" ==> Middleware
    Middleware == "4. middleware 목록에 결합" ==> Agent
    Checkpointer == "5. checkpointer로 결합" ==> Agent
    Agent -. "실행 가능한 summary_agent" .-> Config
    Config -. "invoke/get_state에서 동일 thread 식별" .-> Agent
