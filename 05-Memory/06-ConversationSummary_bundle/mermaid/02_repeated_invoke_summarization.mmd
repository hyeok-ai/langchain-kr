---
title: 2. questions 반복 → summary_agent.invoke() → 대화 요약 · 상태 유지
---
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace;
    classDef agentBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:3px,text-align:left,font-family:"Noto Sans Mono CJK KR",monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef middlewareBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef stateBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#9cdcfe,stroke:#4fc1ff,stroke-width:2px,text-align:left,font-family:monospace;

    Questions["questions = [<br/>  '유럽 14박 15일 패키지의 기본 가격은 3,500유로라고 기억해 주세요.',<br/>  '주요 방문지는 파리, 로마, 베를린, 취리히입니다.',<br/>  '기본 여행자 보험이 포함되고, 비즈니스석 업그레이드는 1,200유로입니다.',<br/>  '호텔은 4성급이며 매일 조식만 포함됩니다.',<br/>  '예약금은 500유로이고 30일 전까지 취소하면 전액 환불됩니다.',<br/>  '지금까지 알려드린 가격과 취소 조건을 정리해 주세요.',<br/>]"]:::codeBlock

    Loop["for question in questions:"]:::execBlock

    Agent["summary_agent<br/>├─ model=model<br/>├─ SummarizationMiddleware<br/>│  ├─ trigger=('messages', 8)<br/>│  └─ keep=('messages', 4)<br/>└─ checkpointer=InMemorySaver()"]:::agentBlock

    Config["config<br/>└─ thread_id = 'europe-package'"]:::stateBlock

    Invoke["result = summary_agent.invoke(<br/>    {'messages': [<br/>        {'role': 'user', 'content': question}<br/>    ]},<br/>    config=config,<br/>)"]:::execBlock

    ThreadState["동일 thread의 checkpoint 상태<br/>→ 이전 대화 메시지를 다음 호출에도 연결"]:::stateBlock

    Middleware["SummarizationMiddleware 검사<br/><br/>메시지 수가 trigger 기준에 도달하면<br/>오래된 메시지는 요약 컨텍스트로 대체하고<br/>최근 messages 4개는 그대로 유지<br/><br/>※ 정확한 내부 메시지 모양은 버전에 따라 달라질 수 있음"]:::middlewareBlock

    ModelRun["model이 현재 컨텍스트로 응답 생성"]:::agentBlock

    Result["result['messages'][-1].content<br/>└─ 이번 turn의 마지막 AI 응답"]:::resultBlock

    Print["print(<br/>    f'Q: {question}\\n'<br/>    f'A: {result[\'messages\'][-1].content}\\n'<br/>)"]:::codeBlock

    Questions == "1. 질문 하나씩 꺼냄" ==> Loop
    Loop == "2. question 전달" ==> Invoke
    Agent == "3. 실행 대상" ==> Invoke
    Config == "4. 같은 thread_id 전달" ==> Invoke
    ThreadState -. "5. 이전 checkpoint 상태 사용" .-> Invoke
    Invoke == "6. Agent 내부 middleware 적용" ==> Middleware
    Middleware == "7. 필요 시 요약된 컨텍스트 구성" ==> ModelRun
    ModelRun == "8. 응답 + 상태 갱신" ==> ThreadState
    ModelRun == "9. result 반환" ==> Result
    Result == "10. 마지막 AI 메시지 출력" ==> Print
    Print -. "다음 question" .-> Loop
