graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef funcBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:15px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Install["# 필요한 경우 아래 줄의 주석을 해제하고 한 번만 실행하세요.<br/># %pip install -qU 'langchain>=1.0' 'langchain-openai>=1.0' 'langgraph>=1.0' python-dotenv"]:::codeBlock
    Imports1["import os<br/><br/>from dotenv import load_dotenv<br/>from langchain.chat_models import init_chat_model"]:::codeBlock
    Env["load_dotenv()<br/><br/>MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.6-luna')<br/>model = init_chat_model(MODEL_ID)"]:::codeBlock
    Imports2["from langchain.messages import AIMessage, HumanMessage, SystemMessage, trim_messages<br/>from langchain_core.messages.utils import count_tokens_approximately"]:::codeBlock
    Consts["MAX_TOKENS = 80<br/>SYSTEM_PROMPT = '당신은 공작 기계 설치를 돕는 기술 지원 상담원입니다.'"]:::codeBlock
    Sample["sample_messages = [<br/>    SystemMessage(content=SYSTEM_PROMPT),<br/>    HumanMessage(content='최근에 XG-200 공작 기계를 구매했습니다. 설치를 도와주세요.'),<br/>    AIMessage(content='먼저 설치 장소의 220V 전원과 접지 상태를 확인해 주세요.'),<br/>    HumanMessage(content='전원과 접지를 확인했습니다. 다음은 무엇인가요?'),<br/>    AIMessage(content='평평하고 안정된 바닥에 기계를 두고 수평계를 사용해 수평을 맞추세요.'),<br/>    HumanMessage(content='수평을 맞췄습니다. 케이블은 어떻게 연결하나요?'),<br/>    AIMessage(content='전원을 차단한 상태에서 매뉴얼 5쪽의 배선도 순서대로 연결하세요.'),<br/>    HumanMessage(content='연결을 마쳤습니다. 이제 무엇을 확인해야 하나요?'),<br/>    AIMessage(content='보호 덮개와 비상 정지 버튼을 확인한 뒤 초기 구동 테스트를 진행하세요.'),<br/>]"]:::codeBlock
    TrimStandalone["trimmed = trim_messages(<br/>    sample_messages,<br/>    max_tokens=MAX_TOKENS,<br/>    token_counter='approximate',<br/>    strategy='last',<br/>    start_on='human',<br/>    include_system=True,<br/>    allow_partial=False,<br/>)"]:::execBlock
    PrintStandalone["print('원본 근사 토큰:', count_tokens_approximately(sample_messages))<br/>print('정리 후 근사 토큰:', count_tokens_approximately(trimmed))<br/>print()<br/>for message in trimmed:<br/>    print(f'[{message.type}] {message.content}')"]:::resultBlock
    TrimFunc["def trim_for_model(messages):<br/>    return trim_messages(<br/>        [SystemMessage(content=SYSTEM_PROMPT), *messages],<br/>        max_tokens=MAX_TOKENS,<br/>        token_counter='approximate',<br/>        strategy='last',<br/>        start_on='human',<br/>        include_system=True,<br/>        allow_partial=False,<br/>    )"]:::funcBlock
    CallModel["def call_model(state: MessagesState):<br/>    response = model.invoke(trim_for_model(state['messages']))<br/>    return {'messages': [response]}"]:::funcBlock
    Builder["builder = StateGraph(MessagesState)<br/>builder.add_node('model', call_model)<br/>builder.add_edge(START, 'model')<br/>builder.add_edge('model', END)<br/>token_chat = builder.compile(checkpointer=InMemorySaver())"]:::chainBlock
    Invoke["config = {'configurable': {'thread_id': 'token-demo'}}<br/><br/>result = token_chat.invoke(<br/>    {<br/>        'messages': [<br/>            *sample_messages[1:],<br/>            HumanMessage(content='마지막으로 해야 할 점검을 한 문장으로 알려주세요.'),<br/>        ]<br/>    },<br/>    config=config,<br/>)<br/>print(result['messages'][-1].content)"]:::execBlock
    Inspect["full_history = token_chat.get_state(config).values['messages']<br/>context_used_for_last_call = trim_for_model(full_history[:-1])<br/><br/>print('저장된 전체 메시지 수:', len(full_history))<br/>print('마지막 모델 입력 메시지 수:', len(context_used_for_last_call))"]:::resultBlock

    Install -. "0. 설치(선택)" .-> Imports1
    Imports1 == "1. 모델 초기화 준비" ==> Env
    Imports2 == "2. 메시지/토큰 유틸 준비" ==> Consts
    Consts == "3. 샘플 대화 작성" ==> Sample
    Sample == "4. 단독 trim 실험" ==> TrimStandalone
    TrimStandalone == "5. 토큰 수/결과 출력" ==> PrintStandalone
    Consts == "6. 재사용 함수 정의" ==> TrimFunc
    Env == "7. model 사용" ==> CallModel
    TrimFunc == "8. trim_for_model 재사용" ==> CallModel
    CallModel == "9. LangGraph 노드 등록" ==> Builder
    Sample == "10. invoke 입력 메시지 재사용" ==> Invoke
    Builder -. "11. 컴파일된 token_chat 실행" .-> Invoke
    Invoke == "12. checkpoint 상태 조회" ==> Inspect
    TrimFunc == "13. 마지막 호출 입력 재계산" ==> Inspect
