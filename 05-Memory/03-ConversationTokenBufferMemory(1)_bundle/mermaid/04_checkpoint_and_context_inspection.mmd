graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Config["config = {'configurable': {'thread_id': 'token-demo'}}"]:::codeBlock
    StateRead["full_history = token_chat.get_state(config).values['messages']"]:::execBlock
    FullHistory["full_history<br/>└─ checkpoint 에 저장된 전체 메시지들<br/>   (이전 대화 + 마지막 AI 응답 포함)"]:::resultBlock
    Slice["full_history[:-1]<br/>└─ 마지막 AI 응답을 제외한 메시지들"]:::resultBlock
    RebuildContext["context_used_for_last_call = trim_for_model(full_history[:-1])"]:::execBlock
    Context["context_used_for_last_call<br/>└─ 마지막 모델 호출 직전에 실제로 모델에 들어간 문맥(재구성)"]:::resultBlock
    PrintCounts["print('저장된 전체 메시지 수:', len(full_history))<br/>print('마지막 모델 입력 메시지 수:', len(context_used_for_last_call))"]:::resultBlock
    Meaning["의미<br/>- checkpointer 는 전체 히스토리를 저장함<br/>- 하지만 모델 호출 직전에는 trim_for_model() 로 토큰 예산에 맞게 다시 잘라서 사용함<br/>- 즉 저장 히스토리와 실제 모델 입력 문맥의 길이는 다를 수 있음"]:::resultBlock

    Config == "1. thread_id 로 상태 조회" ==> StateRead
    StateRead == "2. 저장된 전체 히스토리 확보" ==> FullHistory
    FullHistory == "3. 마지막 AI 응답 제외" ==> Slice
    Slice == "4. 마지막 호출 입력 문맥 재구성" ==> RebuildContext
    RebuildContext == "5. 실제 사용 문맥 확인" ==> Context
    FullHistory == "6. 전체 메시지 수 계산" ==> PrintCounts
    Context == "7. 마지막 입력 메시지 수 계산" ==> PrintCounts
    PrintCounts == "8. 저장 히스토리 vs 실제 입력 차이 해석" ==> Meaning
