    Imports["from langchain.messages import AIMessage, HumanMessage, SystemMessage, trim_messages<br/>from langchain_core.messages.utils import count_tokens_approximately"]:::codeBlock
    Consts["MAX_TOKENS = 80<br/>SYSTEM_PROMPT = '당신은 공작 기계 설치를 돕는 기술 지원 상담원입니다.'"]:::codeBlock
    Sample["sample_messages = [<br/>    SystemMessage(content=SYSTEM_PROMPT),<br/>    HumanMessage(content='최근에 XG-200 공작 기계를 구매했습니다. 설치를 도와주세요.'),<br/>    AIMessage(content='먼저 설치 장소의 220V 전원과 접지 상태를 확인해 주세요.'),<br/>    HumanMessage(content='전원과 접지를 확인했습니다. 다음은 무엇인가요?'),<br/>    AIMessage(content='평평하고 안정된 바닥에 기계를 두고 수평계를 사용해 수평을 맞추세요.'),<br/>    HumanMessage(content='수평을 맞췄습니다. 케이블은 어떻게 연결하나요?'),<br/>    AIMessage(content='전원을 차단한 상태에서 매뉴얼 5쪽의 배선도 순서대로 연결하세요.'),<br/>    HumanMessage(content='연결을 마쳤습니다. 이제 무엇을 확인해야 하나요?'),<br/>    AIMessage(content='보호 덮개와 비상 정지 버튼을 확인한 뒤 초기 구동 테스트를 진행하세요.'),<br/>]"]:::codeBlock
    Trim["trimmed = trim_messages(<br/>    sample_messages,<br/>    max_tokens=MAX_TOKENS,<br/>    token_counter='approximate',<br/>    strategy='last',<br/>    start_on='human',<br/>    include_system=True,<br/>    allow_partial=False,<br/>)"]:::execBlock
    Print1["print('원본 근사 토큰:', count_tokens_approximately(sample_messages))<br/>print('정리 후 근사 토큰:', count_tokens_approximately(trimmed))"]:::resultBlock
    Print2["for message in trimmed:<br/>    print(f'[{message.type}] {message.content}')"]:::resultBlock
    Meaning["의미<br/>- strategy='last' : 최근 메시지 위주로 남김<br/>- include_system=True : 시스템 메시지는 유지<br/>- start_on='human' : 잘린 결과가 human에서 시작되도록 조정<br/>- allow_partial=False : 메시지 일부만 남기는 것 금지"]:::resultBlock

