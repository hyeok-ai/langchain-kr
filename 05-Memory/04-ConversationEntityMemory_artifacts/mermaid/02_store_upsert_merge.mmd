graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef storeBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef branchBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:center,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Store["entity_store = InMemoryStore()"]:::storeBlock
    User["user_id = 'user-123'"]:::codeBlock
    Namespace["namespace = (<br/>    'users',<br/>    user_id,<br/>    'entities'<br/>)"]:::codeBlock

    Extracted["extracted.people<br/>└─ 구조화 추출된 Person 객체 목록"]:::resultBlock

    Loop["for person in extracted.people:<br/>    upsert_person(person)"]:::execBlock

    Dump["new_value = person.model_dump(<br/>    exclude_none=True<br/>)"]:::codeBlock

    Get["current = entity_store.get(<br/>    namespace,<br/>    person.name<br/>)"]:::storeBlock

    Exists{"current 존재?"}:::branchBlock

    Merge["merged = {<br/>    **current.value,<br/>    **new_value<br/>}"]:::codeBlock

    NewOnly["merged = new_value"]:::codeBlock

    Put["entity_store.put(<br/>    namespace,<br/>    person.name,<br/>    merged<br/>)"]:::storeBlock

    Stored["저장 위치<br/>namespace = ('users', user_id, 'entities')<br/>key = person.name<br/>value = merged"]:::resultBlock

    User == "1. 사용자별 구분값" ==> Namespace
    Store -. "Store 인스턴스" .-> Get
    Store -. "같은 Store 인스턴스" .-> Put
    Namespace -. "조회/저장 namespace" .-> Get
    Namespace -. "조회/저장 namespace" .-> Put
    Extracted == "2. Person별 반복" ==> Loop
    Loop == "3. upsert_person(person)" ==> Dump
    Dump == "4. 새 값 구성" ==> Get
    Get == "5. 기존 key 조회" ==> Exists
    Exists == "Yes: 기존 값 있음" ==> Merge
    Exists == "No: 신규 엔티티" ==> NewOnly
    Merge == "6. 새 값이 같은 key를 덮어씀" ==> Put
    NewOnly == "6. 그대로 저장" ==> Put
    Put == "7. upsert 완료" ==> Stored

    Store ~~~ User
