graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef storeBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef branchBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:center,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Store["entity_store<br/>└─ InMemoryStore 인스턴스"]:::storeBlock
    Namespace["namespace = ('users', user_id, 'entities')"]:::codeBlock
    Key["key = '셜리'"]:::codeBlock

    Get["shirley = entity_store.get(<br/>    namespace,<br/>    '셜리'<br/>)"]:::execBlock

    Exists{"shirley 존재?"}:::branchBlock

    Value["shirley.value<br/>└─ 저장된 셜리 엔티티 dict"]:::resultBlock

    Missing["'셜리'라는 key가 없습니다.<br/>추출 결과의 실제 이름을 확인하세요."]:::resultBlock

    Store == "1. Store 직접 조회" ==> Get
    Namespace == "2. namespace 지정" ==> Get
    Key == "3. key 지정" ==> Get
    Get == "4. Store Item 또는 None" ==> Exists
    Exists == "Yes" ==> Value
    Exists == "No" ==> Missing
