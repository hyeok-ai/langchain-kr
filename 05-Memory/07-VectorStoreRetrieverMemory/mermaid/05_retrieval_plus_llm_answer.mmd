graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:center,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    ImportModel["from langchain.chat_models import init_chat_model"]:::codeBlock

    ModelInit["MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.4-mini')<br/>model = init_chat_model(MODEL_ID)"]:::codeBlock

    Query["query = '면접자가 프로젝트에서 맡은 역할을 한 문장으로 답해 주세요.'"]:::codeBlock

    Search["memories = memory_store.search(namespace, query=query, limit=2)"]:::execBlock

    Context["context = '\n\n'.join(item.value['text'] for item in memories)"]:::chainBlock

    PromptMsgs["response = model.invoke([<br/>    {<br/>        'role': 'system',<br/>        'content': (<br/>            '아래 면접 기록만 근거로 답하세요. 근거가 없으면 모른다고 하세요.\n\n'<br/>            f'면접 기록:\n{context}'<br/>        ),<br/>    },<br/>    {'role': 'user', 'content': query},<br/>])"]:::execBlock

    PromptShape["LLM에 전달되는 메시지 구조<br/><br/>system:<br/>- 규칙: 면접 기록만 근거로 답하기<br/>- context: search 결과 2개를 이어붙인 문자열<br/><br/>user:<br/>- query 그대로 전달"]:::chainBlock

    Output["print(response.content)<br/><br/>예상 답변 방향:<br/>'지원자는 백엔드 개발자로서 서버 로직, REST API, 데이터베이스 설계를 담당했습니다.'"]:::resultBlock

    ImportModel == "1. 모델 초기화 함수 import" ==> ModelInit
    ModelInit == "2. chat model 준비" ==> Query
    Query == "3. 같은 query로 메모리 검색" ==> Search
    Search == "4. 검색된 memory들을 context 문자열로 결합" ==> Context
    Context == "5. system/user 메시지 조립" ==> PromptMsgs
    PromptMsgs == "6. invoke에 사용된 메시지 구조 해석" ==> PromptShape
    PromptShape == "7. 최종 content 출력" ==> Output
