digraph G {
  rankdir=TB;
  graph [bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.6", fontname="Noto Sans CJK KR"];
  node [shape=box, style="rounded,filled", fillcolor="#1e1e1e", color="#444444", fontname="Noto Sans CJK KR", fontcolor="#d4d4d4", fontsize=11, margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK KR", color="#333333", fontsize=10, penwidth=1.4];
  labelloc="t"; label="02. Setup Embedding Store"; fontsize=20; fontname="Noto Sans CJK KR";
  pip [label="# %pip install -qU 'langchain>=1.0' 'langchain-openai>=1.0'\l# 'langgraph>=1.0' python-dotenv numpy\l"];
  imports [label="import os\l\lfrom dotenv import load_dotenv\lfrom langchain_openai import OpenAIEmbeddings\lfrom langgraph.store.base import IndexConfig\lfrom langgraph.store.memory import InMemoryStore\l"];
  env [label="load_dotenv()\l\lEMBEDDING_MODEL = os.getenv('EMBEDDING_MODEL', 'text-embedding-3-small')\lEMBEDDING_DIMENSIONS = int(os.getenv('EMBEDDING_DIMENSIONS', '1536'))\l"];
  emb [label="embeddings = OpenAIEmbeddings(model=EMBEDDING_MODEL)\l", color="#569cd6", fontcolor="#569cd6"];
  idx [label="IndexConfig(\l    embed=embeddings,\l    dims=EMBEDDING_DIMENSIONS,\l    fields=['text'],\l)\l", color="#569cd6", fontcolor="#569cd6"];
  store [label="memory_store = InMemoryStore(\l    index=IndexConfig(\l        embed=embeddings,\l        dims=EMBEDDING_DIMENSIONS,\l        fields=['text'],\l    )\l)\l", color="#ce9178", fontcolor="#ce9178"];
  ready [label="memory_store 준비 완료\l- text 필드를 임베딩 대상으로 사용\l- InMemoryStore 내부 인덱스 구성 완료\l", color="#6a9955", fontcolor="#b5cea8"];
  pip -> imports [label="0. 필요 패키지"];
  imports -> env [label="1. import"];
  env -> emb [label="2. env 기반 임베딩 모델 결정"];
  emb -> idx [label="3. embed 객체 주입"];
  idx -> store [label="4. index 설정으로 저장소 생성"];
  store -> ready [label="5. 이후 put/search 재사용"];
}
