digraph G {
  rankdir=TB;
  graph [bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.55", fontname="Noto Sans CJK KR"];
  node [shape=box, style="rounded,filled", fillcolor="#1e1e1e", color="#444444", fontname="Noto Sans CJK KR", fontcolor="#d4d4d4", fontsize=11, margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK KR", color="#333333", fontsize=10, penwidth=1.4];
  labelloc="t"; label="05. Retrieval + LLM Answer"; fontsize=20; fontname="Noto Sans CJK KR";
  imp [label="from langchain.chat_models import init_chat_model\l"];
  model [label="MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.4-mini')\lmodel = init_chat_model(MODEL_ID)\l"];
  query [label="query = '면접자가 프로젝트에서 맡은 역할을 한 문장으로 답해 주세요.'\l"];
  search [label="memories = memory_store.search(namespace, query=query, limit=2)\l", color="#ce9178", fontcolor="#ce9178"];
  ctx [label="context = '\\n\\n'.join(item.value['text'] for item in memories)\l", color="#569cd6", fontcolor="#569cd6"];
  invoke [label="response = model.invoke([\l    {\l        'role': 'system',\l        'content': ('아래 면접 기록만 근거로 답하세요. 근거가 없으면 모른다고 하세요.\\n\\n'\l                   f'면접 기록:\\n{context}'),\l    },\l    {'role': 'user', 'content': query},\l])\l", color="#ce9178", fontcolor="#ce9178"];
  shape [label="LLM에 전달되는 메시지 구조\l- system: 규칙 + 검색된 context\l- user: query 원문\l", color="#569cd6", fontcolor="#569cd6"];
  out [label="print(response.content)\l\l예상 답변 방향:\l지원자는 백엔드 개발자로서 서버 로직, REST API, 데이터베이스 설계를 담당했습니다.\l", color="#6a9955", fontcolor="#b5cea8"];
  imp -> model [label="1. 모델 준비"];
  model -> query [label="2. 질문 정의"];
  query -> search [label="3. 같은 query로 관련 memory 검색"];
  search -> ctx [label="4. 검색 결과를 context 문자열로 조립"];
  ctx -> invoke [label="5. invoke용 메시지 구성"];
  invoke -> shape [label="6. system/user 역할 분리"];
  shape -> out [label="7. response.content 출력"];
}
