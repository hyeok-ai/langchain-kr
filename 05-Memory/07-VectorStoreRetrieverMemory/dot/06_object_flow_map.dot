digraph G {
  rankdir=TB;
  graph [bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.55", fontname="Noto Sans CJK KR"];
  node [shape=box, style="rounded,filled", fillcolor="#1e1e1e", color="#444444", fontname="Noto Sans CJK KR", fontcolor="#d4d4d4", fontsize=11, margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK KR", color="#333333", fontsize=10, penwidth=1.4];
  labelloc="t"; label="06. Object Flow Map"; fontsize=20; fontname="Noto Sans CJK KR";
  env [label="환경설정 객체\lEMBEDDING_MODEL\lEMBEDDING_DIMENSIONS\lCHAT_MODEL\l"];
  emb [label="embeddings = OpenAIEmbeddings(model=EMBEDDING_MODEL)\l", color="#569cd6", fontcolor="#569cd6"];
  idx [label="IndexConfig(embed=embeddings, dims=EMBEDDING_DIMENSIONS, fields=['text'])\l", color="#569cd6", fontcolor="#569cd6"];
  store [label="memory_store = InMemoryStore(index=IndexConfig(...))\l", color="#ce9178", fontcolor="#ce9178"];
  ns [label="namespace = ('users', 'candidate-001', 'interview-memories')\l"];
  put [label="memory_store.put(namespace, key, value)\l", color="#ce9178", fontcolor="#ce9178"];
  search [label="memory_store.search(namespace, query=query, limit=1 or 2)\l", color="#ce9178", fontcolor="#ce9178"];
  memories [label="results / memories\l각 item은 score와 value['text']를 가짐\l", color="#6a9955", fontcolor="#b5cea8"];
  model [label="model = init_chat_model(MODEL_ID)\l", color="#569cd6", fontcolor="#569cd6"];
  invoke [label="model.invoke([system_message, user_message])\l", color="#ce9178", fontcolor="#ce9178"];
  answer [label="response.content\l", color="#6a9955", fontcolor="#b5cea8"];
  env -> emb [label="1. embedding model"];
  emb -> idx [label="2. embed를 index 설정에 연결"];
  idx -> store [label="3. memory_store 생성"];
  store -> put [label="4. put에 사용"];
  ns -> put [label="5. namespace"];
  put -> search [label="6. 저장된 memory가 검색 대상"];
  store -> search [label="7. search에 사용"];
  ns -> search [label="8. namespace"];
  search -> memories [label="9. retrieval 결과"];
  env -> model [label="10. chat model"];
  model -> invoke [label="11. invoke 호출"];
  memories -> invoke [label="12. context로 변환되어 system message에 들어감"];
  invoke -> answer [label="13. final answer"];
}
