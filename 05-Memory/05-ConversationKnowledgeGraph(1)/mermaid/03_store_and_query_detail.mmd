    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef storeBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Knowledge["knowledge : KnowledgeTriples<br/>└─ knowledge.triples : list[Triple]<br/><br/># 앞 단계의 triple_extractor.invoke(...) 결과"]:::resultBlock

    Imports["from hashlib import sha256<br/><br/>from langgraph.store.memory import InMemoryStore"]:::codeBlock

    Store["triple_store = InMemoryStore()<br/>namespace = ('knowledge', 'company-demo')"]:::storeBlock

    KeyFn["def triple_key(triple: Triple) -> str:<br/>　canonical = f'{triple.subject}|{triple.predicate}|{triple.object}'<br/>　return sha256(canonical.encode('utf-8')).hexdigest()[:16]"]:::storeBlock

    PutLoop["for triple in knowledge.triples:<br/>　triple_store.put(<br/>　　namespace,<br/>　　triple_key(triple),<br/>　　triple.model_dump(),<br/>　)"]:::execBlock

    Stored["InMemoryStore<br/>namespace = ('knowledge', 'company-demo')<br/>key = SHA256(subject|predicate|object)[:16]<br/>value = triple.model_dump()<br/><br/>→ 같은 triple은 같은 내용 기반 key를 사용"]:::resultBlock

    FactsFn["def facts_about(entity: str) -> list[dict]:<br/>　items = triple_store.search(namespace, limit=100)<br/>　return [<br/>　　item.value<br/>　　for item in items<br/>　　if entity in item.value['subject']<br/>　　　or entity in item.value['object']<br/>　]"]:::storeBlock

    Search["items = triple_store.search(namespace, limit=100)<br/><br/># namespace의 저장 항목을 최대 100개 조회"]:::execBlock

    Filter["[<br/>　item.value<br/>　for item in items<br/>　if entity in item.value['subject']<br/>　　or entity in item.value['object']<br/>]"]:::execBlock

    Call["shirley_facts = facts_about('김셜리')<br/>shirley_facts"]:::execBlock

    Facts["shirley_facts : list[dict]<br/>└─ subject 또는 object에 '김셜리'가 포함된 저장 triple"]:::resultBlock

    Imports ==> Store
    Store == "1. 저장소 / namespace" ==> PutLoop
    KeyFn == "2. 내용 기반 key" ==> PutLoop
    Knowledge == "3. knowledge.triples 순회" ==> PutLoop
    PutLoop == "4. put(namespace, key, value)" ==> Stored
    Store -. "같은 triple_store 사용" .-> FactsFn
    FactsFn -. "내부 조회" .-> Search
    Search == "5. items" ==> Filter
    Filter -. "facts_about의 반환 로직" .-> Call
    Call == "6. 김셜리 관련 triple" ==> Facts
