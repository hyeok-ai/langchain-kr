---
title: 1. 관계 스키마 + 구조화 Triple 추출
---
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef structBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    ModelInit["MODEL_ID = os.getenv('CHAT_MODEL',<br/>    'openai:gpt-5.6-luna')<br/><br/>model = init_chat_model(MODEL_ID)"]:::codeBlock

    TripleSchema["class Triple(BaseModel):<br/>    subject: str = Field(description='관계의 출발 엔티티')<br/>    predicate: str = Field(description='간결한 관계 이름')<br/>    object: str = Field(description='관계의 도착 엔티티 또는 값')"]:::schemaBlock

    KnowledgeSchema["class KnowledgeTriples(BaseModel):<br/>    triples: list[Triple]"]:::schemaBlock

    Extractor["triple_extractor =<br/>    model.with_structured_output(<br/>        KnowledgeTriples<br/>    )"]:::structBlock

    Source["source_text = (<br/>    '김셜리씨는 판교에 거주합니다. '<br/>    '김셜리씨는 우리 회사의 신입 디자이너입니다. '<br/>    '테디는 김셜리씨와 같은 회사에서 일하는 동료입니다.'<br/>)"]:::codeBlock

    SystemMsg["system message<br/><br/>'텍스트에 명시된 사실만 지식 그래프 triple로 추출하세요. '<br/>'각 관계는 subject, predicate, object로 표현하고 추측하지 마세요.'"]:::codeBlock

    Invoke["knowledge = triple_extractor.invoke([<br/>    {'role': 'system', 'content': (...)},<br/>    {'role': 'user', 'content': source_text}<br/>])"]:::execBlock

    Result["knowledge : KnowledgeTriples<br/><br/>knowledge.triples<br/>└─ list[Triple]<br/>   ├─ subject<br/>   ├─ predicate<br/>   └─ object"]:::resultBlock

    ModelInit == "1. 원본 model" ==> Extractor
    TripleSchema == "2. Triple 원소 스키마" ==> KnowledgeSchema
    KnowledgeSchema == "3. 전체 출력 스키마" ==> Extractor
    Extractor -. "구조화 출력 Runnable" .-> Invoke
    SystemMsg == "4. 추출 규칙" ==> Invoke
    Source == "5. user content" ==> Invoke
    Invoke == "6. 검증된 KnowledgeTriples 반환" ==> Result

    TripleSchema ~~~ ModelInit
    Source ~~~ SystemMsg
