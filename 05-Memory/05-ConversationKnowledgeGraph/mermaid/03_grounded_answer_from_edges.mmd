---
title: 3. 조회한 Edge만 근거로 답변
---
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef contextBlock fill:#1e1e1e,color:#9cdcfe,stroke:#9cdcfe,stroke-width:2px,text-align:left,font-family:monospace;
    classDef modelBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Facts["shirley_facts<br/>└─ facts_about('김셜리') 결과<br/>└─ 김셜리와 직접 연결된 edge dict 목록"]:::codeBlock

    Context["context = '\\n'.join(<br/>    f\"- {fact['subject']} --{fact['predicate']}--&gt; {fact['object']}\"<br/>    for fact in shirley_facts<br/>)"]:::contextBlock

    ContextText["context 문자열 예시<br/><br/>- 김셜리씨 --거주--&gt; 판교<br/>- 김셜리씨 --직업/역할--&gt; 신입 디자이너<br/>- 테디 --동료 관계--&gt; 김셜리씨"]:::contextBlock

    Model["model<br/>└─ init_chat_model(MODEL_ID)"]:::modelBlock

    System["system content =<br/>'아래 Relevant facts에 포함된 사실만 사용하세요. '<br/>'근거가 없으면 모른다고 답하세요.\\n\\n'<br/>f'Relevant facts:\\n{context}'"]:::codeBlock

    User["user content =<br/>'김셜리씨는 누구이며 어디에 거주합니까?'"]:::codeBlock

    Invoke["response = model.invoke([<br/>    {'role': 'system', 'content': (...)},<br/>    {'role': 'user', 'content': '김셜리씨는 누구이며 어디에 거주합니까?'}<br/>])"]:::execBlock

    Response["response : AIMessage<br/>└─ response.content"]:::resultBlock

    Print["print(response.content)"]:::resultBlock

    Facts == "1. 조회된 edge 목록" ==> Context
    Context == "2. 한 줄씩 직렬화" ==> ContextText
    ContextText == "3. Relevant facts에 삽입" ==> System
    Model == "4. 답변 모델" ==> Invoke
    System == "5. 근거 제한 system message" ==> Invoke
    User == "6. 사용자 질문" ==> Invoke
    Invoke == "7. AIMessage 반환" ==> Response
    Response == "8. content 출력" ==> Print

    Model ~~~ Facts
