graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef funcBlock fill:#1e1e1e,color:#9cdcfe,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef graphBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#2ea043,stroke-width:2px,text-align:left,font-family:monospace;
    classDef noteBlock fill:#1e1e1e,color:#dcdcaa,stroke:#ffd700,stroke-width:2px,text-align:left,font-family:monospace;

    Setup["# 필요한 경우 아래 줄의 주석을 해제하고 한 번만 실행하세요.<br/># %pip install -qU 'langchain>=1.0' 'langchain-openai>=1.0' 'langgraph>=1.0' python-dotenv"]:::noteBlock

    ImportsModel["import os<br/><br/>from dotenv import load_dotenv<br/>from langchain.chat_models import init_chat_model<br/><br/>load_dotenv()<br/><br/># 다른 공급자를 쓸 때는 예: anthropic:claude-... 처럼 지정할 수 있습니다.<br/>MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.6-luna')<br/>model = init_chat_model(MODEL_ID)"]:::funcBlock

    ImportsGraph["from langchain.messages import SystemMessage<br/>from langgraph.checkpoint.memory import InMemorySaver<br/>from langgraph.graph import END, START, MessagesState, StateGraph"]:::graphBlock

    Constants["K = 2<br/>SYSTEM_PROMPT = '당신은 친절한 은행 상담 챗봇입니다.'"]:::noteBlock

    ContextFunc["def context_for_model(messages):<br/>    '''완료된 최근 K개 turn과 현재 사용자 메시지를 선택합니다.'''<br/>    if not messages or messages[-1].type != 'human':<br/>        raise ValueError('마지막 메시지는 현재 사용자의 human 메시지여야 합니다.')<br/><br/>    history, current_user_message = messages[:-1], messages[-1]<br/>    recent_history = history[-2 * K :]  # human/ai 한 쌍이 1 turn<br/>    return [<br/>        SystemMessage(content=SYSTEM_PROMPT),<br/>        *recent_history,<br/>        current_user_message,<br/>    ]"]:::funcBlock

    CallFunc["def call_model(state: MessagesState):<br/>    response = model.invoke(context_for_model(state['messages']))<br/>    return {'messages': [response]}"]:::funcBlock

    Builder1["builder = StateGraph(MessagesState)<br/>builder.add_node('model', call_model)"]:::graphBlock
    Builder2["builder.add_edge(START, 'model')<br/>builder.add_edge('model', END)"]:::graphBlock
    Compile["window_chat = builder.compile(checkpointer=InMemorySaver())"]:::funcBlock

    Note["핵심 아이디어<br/>1. checkpointer에는 전체 스레드 상태를 보존<br/>2. 모델 호출 직전에 필요한 최근 turn만 선택"]:::noteBlock

    Result["window_chat<br/>└─ LangGraph runnable<br/>   └─ checkpointer = InMemorySaver()"]:::resultBlock

    Setup -. "선택적 1회 설치" .-> ImportsModel
    ImportsModel == "1. 모델 초기화" ==> CallFunc
    Constants == "2. K / SYSTEM_PROMPT 사용" ==> ContextFunc
    ImportsGraph == "3. SystemMessage 사용" ==> ContextFunc
    ContextFunc == "4. 모델 입력 컨텍스트 선택" ==> CallFunc
    ImportsGraph == "그래프 구성용 객체" ==> Builder1
    CallFunc == "5. 노드 함수로 등록" ==> Builder1
    Builder1 == "6. 노드 추가" ==> Builder2
    Builder2 == "7. START / END 연결" ==> Compile
    Note -. "설계 의도" .-> Compile
    Compile == "8. 최종 runnable" ==> Result
