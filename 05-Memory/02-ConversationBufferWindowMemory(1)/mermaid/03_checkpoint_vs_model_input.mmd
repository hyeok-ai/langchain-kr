graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef funcBlock fill:#1e1e1e,color:#9cdcfe,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ff8c00,stroke-width:2px,text-align:left,font-family:monospace;
    classDef noteBlock fill:#1e1e1e,color:#dcdcaa,stroke:#ffd700,stroke-width:2px,text-align:left,font-family:monospace;

    AnalysisCode["all_messages = window_chat.get_state(config).values['messages']<br/>last_call_context = context_for_model(all_messages[:-1])  # 마지막 AI 응답 직전 상태<br/><br/>print('checkpoint에 저장된 메시지 수:', len(all_messages))<br/>print('마지막 모델 호출에 전달된 메시지 수:', len(last_call_context))<br/>print()<br/><br/>for message in last_call_context:<br/>    print(f'[{message.type}] {message.content}')"]:::codeBlock

    AllMessages["all_messages = window_chat.get_state(config).values['messages']<br/><br/>의미:<br/>checkpoint에 저장된 전체 메시지 기록<br/>= 이전 turn 전체 + 마지막 AI 응답까지 포함"]:::codeBlock

    ContextFunc["def context_for_model(messages):<br/>    '''완료된 최근 K개 turn과 현재 사용자 메시지를 선택합니다.'''<br/>    if not messages or messages[-1].type != 'human':<br/>        raise ValueError('마지막 메시지는 현재 사용자의 human 메시지여야 합니다.')<br/><br/>    history, current_user_message = messages[:-1], messages[-1]<br/>    recent_history = history[-2 * K :]<br/>    return [<br/>        SystemMessage(content=SYSTEM_PROMPT),<br/>        *recent_history,<br/>        current_user_message,<br/>    ]"]:::funcBlock

    LastContext["last_call_context = context_for_model(all_messages[:-1])<br/><br/>의미:<br/>마지막 AI 응답 직전 상태를 넣어서<br/>실제로 마지막 model.invoke에 전달된 컨텍스트를 재구성"]:::codeBlock

    Counts["print('checkpoint에 저장된 메시지 수:', len(all_messages))<br/>print('마지막 모델 호출에 전달된 메시지 수:', len(last_call_context))"]:::execBlock

    PrintLoop["for message in last_call_context:<br/>    print(f'[{message.type}] {message.content}')"]:::execBlock

    ExampleContext["예상되는 last_call_context 구성<br/>[system] 당신은 친절한 은행 상담 챗봇입니다.<br/>[human] 본인 인증까지 마쳤습니다. 이제 무엇을 하나요?<br/>[ai] ...<br/>[human] 이용 약관에도 동의했습니다. 마지막 단계는 무엇인가요?<br/>[ai] ...<br/>[human] 가장 최근 안내만 짧게 다시 말해 주세요."]:::codeBlock

    Observation["핵심 비교<br/>- checkpoint에는 모든 turn이 계속 저장됨<br/>- 하지만 model.invoke에는 최근 2개 turn + 현재 질문만 전달됨<br/>- 즉, 저장과 모델 입력이 분리되어 있음"]:::noteBlock

    AnalysisCode == "1. 상태 조회" ==> AllMessages
    AnalysisCode == "2. 마지막 호출 컨텍스트 재구성" ==> LastContext
    ContextFunc == "3. context_for_model 재사용" ==> LastContext
    AllMessages == "4. 전체 메시지 수 계산" ==> Counts
    LastContext == "5. 실제 모델 입력 수 계산" ==> Counts
    LastContext == "6. 전달된 메시지 내용 출력" ==> PrintLoop
    PrintLoop == "7. 어떤 메시지가 남는지 확인" ==> ExampleContext
    Counts == "8. 수량 비교" ==> Observation
    ExampleContext == "9. 내용 비교" ==> Observation
