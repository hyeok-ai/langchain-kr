graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef funcBlock fill:#1e1e1e,color:#9cdcfe,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef graphBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ff8c00,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#2ea043,stroke-width:2px,text-align:left,font-family:monospace;

    Config["config = {'configurable': {'thread_id': 'window-demo'}}"]:::codeBlock

    Questions["questions = [<br/>    '비대면 계좌 개설을 시작하려면 무엇이 필요한가요?',<br/>    '신분증을 준비했습니다. 다음 단계는 무엇인가요?',<br/>    '본인 인증까지 마쳤습니다. 이제 무엇을 하나요?',<br/>    '이용 약관에도 동의했습니다. 마지막 단계는 무엇인가요?',<br/>    '가장 최근 안내만 짧게 다시 말해 주세요.',<br/>]"]:::codeBlock

    LoopExec["for question in questions:<br/>    result = window_chat.invoke(<br/>        {'messages': [{'role': 'user', 'content': question}]},<br/>        config=config,<br/>    )<br/>    print(f'Q: {question}\nA: {result[\"messages\"][-1].content}\n')"]:::execBlock

    InvokeInput["invoke 입력<br/>{'messages': [{'role': 'user', 'content': question}]}<br/>+ config = {'configurable': {'thread_id': 'window-demo'}}"]:::codeBlock

    CheckpointerRestore["checkpointer 동작<br/>같은 thread_id = 'window-demo' 의<br/>기존 전체 messages 상태를 복원"]:::funcBlock

    StateSeen["노드가 받는 state['messages']<br/>= [이전 human/ai 기록 전체..., 현재 human question]"]:::graphBlock

    CallModel["def call_model(state: MessagesState):<br/>    response = model.invoke(context_for_model(state['messages']))<br/>    return {'messages': [response]}"]:::funcBlock

    ContextSelected["def context_for_model(messages):<br/>    '''완료된 최근 K개 turn과 현재 사용자 메시지를 선택합니다.'''<br/>    if not messages or messages[-1].type != 'human':<br/>        raise ValueError('마지막 메시지는 현재 사용자의 human 메시지여야 합니다.')<br/><br/>    history, current_user_message = messages[:-1], messages[-1]<br/>    recent_history = history[-2 * K :]  # human/ai 한 쌍이 1 turn<br/>    return [<br/>        SystemMessage(content=SYSTEM_PROMPT),<br/>        *recent_history,<br/>        current_user_message,<br/>    ]"]:::funcBlock

    ModelInput["실제 model.invoke(...) 입력<br/>[<br/>    SystemMessage(content=SYSTEM_PROMPT),<br/>    최근 2개 turn의 human/ai 메시지들,<br/>    현재 사용자 question<br/>]"]:::graphBlock

    ModelInvoke["response = model.invoke(context_for_model(state['messages']))"]:::execBlock
    ReturnNode["return {'messages': [response]}"]:::funcBlock

    CheckpointUpdated["checkpointer 업데이트<br/>전체 스레드 상태에<br/>현재 user 메시지 + 새 AI 응답 저장"]:::funcBlock

    Result["result<br/>└─ result['messages'][-1].content<br/>   └─ 이번 turn의 AI 답변"]:::resultBlock

    PrintOutput["print(f'Q: {question}\nA: {result[\"messages\"][-1].content}\n')"]:::execBlock

    StoredNote["전체 저장 상태<br/>- 같은 thread_id의 과거 human/ai 메시지 전체<br/>- 현재 사용자 질문까지 포함<br/>- invoke가 반복될수록 누적 저장"]:::graphBlock

    ModelNote["실제 모델 입력<br/>- SYSTEM_PROMPT<br/>- 완료된 최근 K=2 turn<br/>- 현재 사용자 질문<br/>- 전체 기록 중 일부만 모델에 전달"]:::funcBlock

    Config == "1. 같은 thread_id 사용" ==> LoopExec
    Questions == "2. 질문 반복" ==> LoopExec
    LoopExec == "3. invoke 호출" ==> InvokeInput
    InvokeInput == "4. checkpointer가 상태 복원" ==> CheckpointerRestore
    CheckpointerRestore == "5. 전체 messages 상태 구성" ==> StateSeen
    StateSeen -. "저장 상태의 의미" .-> StoredNote
    StateSeen == "6. model 노드 실행" ==> CallModel
    CallModel == "7. 내부에서 context_for_model 호출" ==> ContextSelected
    ContextSelected == "8. 최근 K개 turn + 현재 질문 선택" ==> ModelInput
    ContextSelected -. "실제 모델 입력의 의미" .-> ModelNote
    ModelInput == "9. model.invoke 실행" ==> ModelInvoke
    ModelInvoke == "10. AI 응답 생성" ==> ReturnNode
    ReturnNode == "11. 노드 출력 병합 및 저장" ==> CheckpointUpdated
    CheckpointUpdated == "12. invoke 결과 반환" ==> Result
    Result == "13. 콘솔 출력" ==> PrintOutput
