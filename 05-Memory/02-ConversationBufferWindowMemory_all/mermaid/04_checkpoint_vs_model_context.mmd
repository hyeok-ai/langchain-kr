---
title: "4. 저장된 전체 기록 vs 마지막 모델 입력 비교"
---
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef logicBlock fill:#1e1e1e,color:#9cdcfe,stroke:#9cdcfe,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef memoryBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    GetState["all_messages =<br/>    window_chat.get_state(config).values['messages']"]:::execBlock

    All["all_messages<br/>H1, A1, H2, A2, H3, A3, H4, A4, H5, A5<br/><br/>len(all_messages) = 10"]:::memoryBlock

    Slice["all_messages[:-1]<br/>└─ 마지막 A5 제거<br/>└─ 마지막 원소가 H5가 되도록 복원"]:::codeBlock

    Context["last_call_context = context_for_model(all_messages[:-1])<br/><br/>history = H1,A1,H2,A2,H3,A3,H4,A4<br/>current = H5<br/>recent_history = history[-4:]"]:::logicBlock

    Last["last_call_context<br/>SystemMessage<br/>+ H3, A3<br/>+ H4, A4<br/>+ H5<br/><br/>len(last_call_context) = 6"]:::memoryBlock

    Print["print('checkpoint에 저장된 메시지 수:', len(all_messages))<br/>print('마지막 모델 호출에 전달된 메시지 수:', len(last_call_context))<br/><br/>for message in last_call_context:<br/>    print(f'[{message.type}] {message.content}')"]:::execBlock

    GetState == "1. checkpoint 전체 상태 조회" ==> All
    All == "2. 마지막 AI 응답 직전 상태 재구성" ==> Slice
    Slice == "3. context_for_model 호출" ==> Context
    Context == "4. 최근 2 turn + 현재 질문 선택" ==> Last
    All -. "전체 기록 10개" .-> Print
    Last == "실제 모델 입력 6개" ==> Print
