graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef storeBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    classDef branchBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;

    Extracted["extracted : People<br/>└─ extracted.people : list[Person]"]:::resultBlock

    StoreInit["from langgraph.store.memory import InMemoryStore<br/><br/>entity_store = InMemoryStore()<br/>user_id = 'user-123'<br/>namespace = ('users', user_id, 'entities')"]:::storeBlock

    Loop["for person in extracted.people:<br/>upsert_person(person)"]:::execBlock

    Func["def upsert_person(person: Person) -> None:<br/>new_value = person.model_dump(exclude_none=True)<br/>current = entity_store.get(namespace, person.name)<br/>merged = {**current.value, **new_value} if current else new_value<br/>entity_store.put(namespace, person.name, merged)"]:::storeBlock

    Dump["new_value = person.model_dump(exclude_none=True)<br/><br/>Pydantic Person 객체<br/>→ None 필드를 제외한 dict"]:::codeBlock

    GetCurrent["current = entity_store.get(namespace, person.name)"]:::execBlock

    Branch{"current가 존재하는가?"}:::branchBlock

    MergeExisting["merged = {**current.value, **new_value}<br/><br/>기존 dict를 먼저 펼치고<br/>new_value를 뒤에 펼치므로<br/>같은 key는 새 값이 덮어씀"]:::codeBlock

    MergeNew["merged = new_value"]:::codeBlock

    Put["entity_store.put(<br/>namespace,<br/>person.name,<br/>merged<br/>)"]:::execBlock

    Store["entity_store : InMemoryStore<br/><br/>namespace<br/>('users', 'user-123', 'entities')<br/><br/>key<br/>person.name<br/><br/>value<br/>merged dict"]:::resultBlock

    Search["# namespace에 저장된 모든 엔티티<br/>[item.value for item in entity_store.search(namespace)]"]:::execBlock

    SearchResult["entity_store.search(namespace)<br/>→ Store item 목록<br/>→ item.value만 list comprehension으로 추출"]:::resultBlock

    DirectGet["# key를 알고 있을 때는 직접 조회합니다.<br/>shirley = entity_store.get(namespace, '셜리')"]:::execBlock

    Found{"shirley가 존재하는가?"}:::branchBlock

    ShirleyValue["shirley.value"]:::resultBlock
    Missing["'셜리'라는 key가 없습니다. 추출 결과의 실제 이름을 확인하세요."]:::resultBlock

    Extracted == "1. Person 목록" ==> Loop
    Loop == "2. 각 person마다 함수 호출" ==> Func
    StoreInit == "3. Store와 namespace 의존성" ==> Func

    Func == "4-A. Pydantic → dict" ==> Dump
    Dump == "4-B. 같은 name key 조회" ==> GetCurrent
    StoreInit == "namespace + entity_store" ==> GetCurrent
    GetCurrent ==> Branch
    Branch == "Yes" ==> MergeExisting
    Branch == "No" ==> MergeNew
    MergeExisting ==> Put
    MergeNew ==> Put
    Put == "5. upsert 완료" ==> Store

    Store == "6-A. 전체 namespace 검색" ==> Search
    Search ==> SearchResult

    Store == "6-B. key='셜리' 직접 조회" ==> DirectGet
    DirectGet ==> Found
    Found == "Yes" ==> ShirleyValue
    Found == "No" ==> Missing
