graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef schemaBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef chainBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;

    Env["import os<br/><br/>from dotenv import load_dotenv<br/>from langchain.chat_models import init_chat_model<br/><br/>load_dotenv()<br/><br/>MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.4-mini')<br/>model = init_chat_model(MODEL_ID)"]:::codeBlock

    Person["class Person(BaseModel):<br/>name: str = Field(description='대화에 등장한 사람의 이름')<br/>occupation: str | None = Field(<br/>default=None,<br/>description='직무 또는 역할'<br/>)<br/>relationship: str | None = Field(<br/>default=None,<br/>description='다른 인물과의 관계'<br/>)<br/>plans: list[str] = Field(<br/>default_factory=list,<br/>description='명시적으로 언급된 계획'<br/>)"]:::schemaBlock

    People["class People(BaseModel):<br/>people: list[Person]"]:::schemaBlock

    Extractor["entity_extractor = model.with_structured_output(People)"]:::chainBlock

    Conversation["conversation = (<br/>'테디와 셜리는 한 회사에서 일하는 동료입니다. '<br/>'테디는 개발자이고 셜리는 디자이너입니다. '<br/>'두 사람은 회사를 그만두고 함께 창업할 계획입니다.'<br/>)"]:::codeBlock

    SystemMsg["{<br/>'role': 'system',<br/>'content': (<br/>'주어진 문장에서 명시된 사람 정보만 추출하세요. '<br/>'추측하지 말고, 모르는 필드는 비워 두세요.'<br/>),<br/>}"]:::codeBlock

    UserMsg["{<br/>'role': 'user',<br/>'content': conversation<br/>}"]:::codeBlock

    Invoke["extracted = entity_extractor.invoke(<br/>[<br/>{<br/>'role': 'system',<br/>'content': (<br/>'주어진 문장에서 명시된 사람 정보만 추출하세요. '<br/>'추측하지 말고, 모르는 필드는 비워 두세요.'<br/>),<br/>},<br/>{'role': 'user', 'content': conversation},<br/>]<br/>)"]:::execBlock

    Result["extracted<br/><br/>People(<br/>people=[<br/>Person(...),<br/>Person(...),<br/>]<br/>)<br/><br/>※ 정확한 필드 값은 실제 모델 응답에 의해 결정"]:::resultBlock

    Env == "1. model" ==> Extractor
    Person == "2. Person 스키마 정의" ==> People
    People == "3. People 스키마를 structured output에 설정" ==> Extractor

    Conversation == "4. conversation 문자열" ==> UserMsg
    SystemMsg == "5. system message" ==> Invoke
    UserMsg == "6. user message" ==> Invoke
    Extractor == "7. 구조화 출력 Runnable" ==> Invoke
    Invoke == "8. 검증된 People 객체" ==> Result
