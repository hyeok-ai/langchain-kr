%% 01. 그래프 구성과 compile — MessagesState / call_model / InMemorySaver가 chat 객체로 결합되는 과정
graph TD

    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace;
    classDef stateBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef graphBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace;
    classDef memoryBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    Setup["import os<br/><br/>from dotenv import load_dotenv<br/>from langchain.chat_models import init_chat_model<br/><br/>load_dotenv()<br/><br/># 다른 공급자를 쓸 때는 예: anthropic:claude-... 처럼 지정할 수 있습니다.<br/>MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.6-luna')<br/>model = init_chat_model(MODEL_ID)"]:::codeBlock
    Imports["from langchain.messages import SystemMessage<br/>from langgraph.checkpoint.memory import InMemorySaver<br/>from langgraph.graph import END, START, MessagesState, StateGraph<br/><br/>SYSTEM_PROMPT = '당신은 친절하고 정확한 은행 상담 챗봇입니다.'"]:::codeBlock
    State["MessagesState<br/>└─ messages 필드에 메시지 병합 reducer가 이미 설정됨<br/>└─ 노드가 새 messages만 반환해도 기존 목록 뒤에 병합"]:::stateBlock
    Call["def call_model(state: MessagesState):<br/>    response = model.invoke(<br/>        [SystemMessage(content=SYSTEM_PROMPT), *state['messages']]<br/>    )<br/>    # MessagesState의 reducer가 기존 목록 뒤에 이 메시지를 추가합니다.<br/>    return {'messages': [response]}"]:::execBlock
    Builder["builder = StateGraph(MessagesState)"]:::graphBlock
    NodeReg["builder.add_node('model', call_model)"]:::graphBlock
    Edges["builder.add_edge(START, 'model')<br/>builder.add_edge('model', END)"]:::graphBlock
    Memory["InMemorySaver()<br/>└─ 학습/테스트용 in-memory checkpointer<br/>└─ thread_id별 그래프 상태 저장"]:::memoryBlock
    Compile["chat = builder.compile(checkpointer=InMemorySaver())"]:::graphBlock
    Compiled["chat<br/>└─ invoke(...)<br/>└─ get_state(...)<br/>└─ checkpointer를 포함한 compiled graph"]:::resultBlock

    Setup -- "model.invoke(...)에 사용" --> Call
    Imports -- "SystemMessage / SYSTEM_PROMPT" --> Call
    State -- "state: MessagesState" --> Call
    State == "StateGraph(MessagesState)" ==> Builder
    Builder -- "model 노드 등록" --> NodeReg
    Call == "call_model 함수 자체를 노드 구현으로 등록" ==> NodeReg
    NodeReg -- "START → model → END 연결" --> Edges
    Edges -- "완성된 graph definition" --> Compile
    Memory == "checkpointer 인자로 결합" ==> Compile
    Compile == "compiled graph 반환" ==> Compiled
