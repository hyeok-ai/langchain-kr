%% 02. 첫 번째 ask() — 비어 있는 스레드에서 user1 → ai1을 저장하는 전체 invoke 흐름
graph TD

    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace;
    classDef stateBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef graphBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace;
    classDef memoryBlock fill:#1e1e1e,color:#dcdcaa,stroke:#dcdcaa,stroke-width:2px,text-align:left,font-family:monospace;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    Config["config = {<br/>    'configurable': {'thread_id': 'bank-account-demo'}<br/>}"]:::codeBlock
    Ask["config = {'configurable': {'thread_id': 'bank-account-demo'}}<br/><br/><br/>def ask(text: str) -> str:<br/>    result = chat.invoke(<br/>        {'messages': [{'role': 'user', 'content': text}]},<br/>        config=config,<br/>    )<br/>    return result['messages'][-1].content"]:::codeBlock
    CallSite["print(<br/>    ask(<br/>        '안녕하세요. 비대면으로 은행 계좌를 개설하고 싶습니다. '<br/>        '어떻게 시작해야 하나요?'<br/>    )<br/>)"]:::execBlock
    Invoke["chat.invoke(<br/>    {'messages': [{'role': 'user', 'content': text}]},<br/>    config=config,<br/>)"]:::execBlock
    MemoryLookup["InMemorySaver<br/>lookup(thread_id='bank-account-demo')<br/>→ 첫 호출이므로 기존 checkpoint 없음"]:::memoryBlock
    InputState["MessagesState<br/>messages = [<br/>    HumanMessage('안녕하세요. 비대면으로 ... 어떻게 시작해야 하나요?')<br/>]"]:::stateBlock
    CallModel["def call_model(state: MessagesState):<br/>    response = model.invoke(<br/>        [SystemMessage(content=SYSTEM_PROMPT), *state['messages']]<br/>    )<br/>    # MessagesState의 reducer가 기존 목록 뒤에 이 메시지를 추가합니다.<br/>    return {'messages': [response]}"]:::execBlock
    ModelInput["model.invoke([<br/>    SystemMessage(content=SYSTEM_PROMPT),<br/>    *state['messages']<br/>])<br/><br/>실제 모델 입력 순서:<br/>1) system<br/>2) user1"]:::codeBlock
    Reducer["return {'messages': [response]}<br/><br/>MessagesState reducer:<br/>[user1] + [ai1] → [user1, ai1]"]:::stateBlock
    Save["InMemorySaver<br/>thread_id='bank-account-demo' checkpoint 저장<br/>messages = [user1, ai1]"]:::memoryBlock
    Return["result['messages'][-1].content<br/>→ ai1.content<br/>→ ask()가 str로 반환<br/>→ print(...)"]:::resultBlock

    Config -- "ask() 내부 config로 사용" --> Ask
    Ask -- "첫 번째 ask(text)" --> CallSite
    CallSite == "text 인자로 전달" ==> Invoke
    Invoke -- "config.thread_id로 checkpoint 조회" --> MemoryLookup
    MemoryLookup == "복원할 과거 상태 없음 + 새 user 메시지" ==> InputState
    InputState -- "START → model 노드 실행" --> CallModel
    CallModel == "model.invoke 호출" ==> ModelInput
    ModelInput -- "AI 응답 response 생성" --> Reducer
    Reducer == "병합된 전체 state checkpoint 저장" ==> Save
    Save -- "chat.invoke result 반환" --> Return
