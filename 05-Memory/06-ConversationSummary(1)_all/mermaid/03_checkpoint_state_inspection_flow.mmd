%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}, "theme": "base"}}%%
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef configBlock fill:#1e1e1e,color:#9cdcfe,stroke:#4fc1ff,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef stateBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:3px,text-align:left,font-family:monospace,font-size:14px;
    classDef noteBlock fill:#fff8dc,color:#333,stroke:#d6b656,stroke-width:2px,text-align:left,font-size:14px;

    Agent["summary_agent = create_agent(<br/>　　model=model,<br/>　　tools=[],<br/>　　system_prompt=(...),<br/>　　middleware=[<br/>　　　　SummarizationMiddleware(<br/>　　　　　　model=model,<br/>　　　　　　trigger=('messages', 8),<br/>　　　　　　keep=('messages', 4),<br/>　　　　)<br/>　　],<br/>　　checkpointer=InMemorySaver(),<br/>)"]:::codeBlock

    Config["config = {<br/>　　'configurable': {<br/>　　　　'thread_id': 'europe-package'<br/>　　}<br/>}"]:::configBlock

    PriorLoop["for question in questions:<br/>　　result = summary_agent.invoke(<br/>　　　　{'messages': [{'role': 'user', 'content': question}]},<br/>　　　　config=config,<br/>　　)<br/>　　print(f'Q: {question}\\nA: {result[\'messages\'][-1].content}\\n')<br/><br/>→ 같은 thread_id에 대화 상태가 누적/요약되어 checkpoint에 저장됨"]:::execBlock

    GetState["messages = summary_agent.get_state(config).values['messages']"]:::execBlock

    StateMeaning["summary_agent.get_state(config)<br/>└─ config의 thread_id를 기준으로 checkpoint 상태 조회<br/>　└─ .values['messages']<br/>　　└─ 현재 저장된 message 상태 목록"]:::stateBlock

    Loop["for index, message in enumerate(messages, start=1):<br/>　　preview = str(message.content).replace('\\n', ' ')[:240]<br/>　　print(f'{index:02d}. [{message.type}] {preview}')"]:::execBlock

    Preview["각 message를 사람이 확인하기 쉽게 출력<br/><br/>index: 01, 02, 03, ...<br/>message.type: human / ai / 기타 내부 메시지 타입<br/>message.content: 줄바꿈을 공백으로 바꾸고 앞 240자만 preview"]:::stateBlock

    SummaryEffect["임계치를 넘은 뒤에는<br/>오래된 원문 메시지 일부가<br/>요약 컨텍스트로 대체될 수 있음<br/><br/>최근 메시지는 keep=('messages', 4)에 의해 원문 유지"]:::stateBlock

    Note["노트북에서 강조한 점:<br/>정확한 내부 message 문자열/모양은 LangChain 버전에 따라 달라질 수 있다.<br/>특정 문자열 포맷보다 'messages 상태의 의미'를 기준으로 확인한다."]:::noteBlock

    Durable["반드시 정확히 보존해야 하는 값<br/>예: 주문 번호, 금액, 사용자 설정<br/><br/>→ 요약문에만 의존하지 말고<br/>별도의 구조화 상태 또는 장기 메모리 Store에 저장"]:::noteBlock

    Agent ==> PriorLoop
    Config == "1. invoke와 get_state 모두 동일 config" ==> PriorLoop
    PriorLoop == "2. checkpoint 갱신" ==> GetState
    Config == "3. 같은 thread_id로 상태 조회" ==> GetState
    GetState ==> StateMeaning
    StateMeaning ==> Loop
    Loop ==> Preview
    StateMeaning -. "요약이 발생했다면" .-> SummaryEffect
    SummaryEffect ==> Note
    Note ==> Durable
