%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}, "theme": "base"}}%%
graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef middlewareBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:3px,text-align:left,font-family:monospace,font-size:14px;
    classDef agentBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:3px,text-align:left,font-family:monospace,font-size:14px;
    classDef stateBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef decisionBlock fill:#3a2f1e,color:#ffd866,stroke:#d6b656,stroke-width:3px,font-family:monospace,font-size:14px;
    classDef noteBlock fill:#fff8dc,color:#333,stroke:#d6b656,stroke-width:2px,text-align:left,font-size:14px;

    AgentCode["summary_agent = create_agent(<br/>　　model=model,<br/>　　tools=[],<br/>　　system_prompt=(<br/>　　　　'당신은 여행 상품 상담원입니다. 가격·포함 사항·취소 조건을 정확히 기억하고 '<br/>　　　　'모르는 내용은 추측하지 마세요.'<br/>　　),<br/>　　middleware=[<br/>　　　　SummarizationMiddleware(<br/>　　　　　　model=model,<br/>　　　　　　trigger=('messages', 8),<br/>　　　　　　keep=('messages', 4),<br/>　　　　)<br/>　　],<br/>　　checkpointer=InMemorySaver(),<br/>)"]:::agentBlock

    Config["config = {'configurable': {'thread_id': 'europe-package'}}"]:::codeBlock

    Invoke["result = summary_agent.invoke(<br/>　　{'messages': [{'role': 'user', 'content': question}]},<br/>　　config=config,<br/>)"]:::codeBlock

    LoadState["InMemorySaver에서<br/>thread_id='europe-package'의 이전 상태를 불러옴<br/><br/>→ 이전 대화의 messages가 다음 invoke에도 이어짐"]:::stateBlock

    Append["현재 question을 user message로 입력<br/><br/>{'role': 'user', 'content': question}"]:::stateBlock

    Middleware["SummarizationMiddleware<br/><br/>model=model<br/>trigger=('messages', 8)<br/>keep=('messages', 4)"]:::middlewareBlock

    Trigger{"messages 기준<br/>요약 trigger 조건에<br/>도달했는가?"}:::decisionBlock

    NoSummary["아직 trigger 전<br/><br/>기존 messages를 유지한 채<br/>main model 호출로 진행"]:::stateBlock

    Split["trigger 도달<br/><br/>오래된 대화 영역과<br/>최근 유지 영역을 나눔<br/><br/>keep=('messages', 4)<br/>→ 최근 메시지 4개는 원문 유지"]:::middlewareBlock

    SummaryCall["요약용 모델 호출<br/><br/>SummarizationMiddleware(<br/>　　model=model,<br/>　　...<br/>)<br/><br/>오래된 메시지의 핵심 정보를<br/>요약 컨텍스트로 압축"]:::middlewareBlock

    Rebuild["agent가 사용할 대화 컨텍스트<br/><br/>[오래된 대화의 요약 컨텍스트]<br/>＋<br/>[최근 원문 messages 4개]<br/><br/>※ 정확한 내부 messages 모양은 버전에 따라 달라질 수 있음"]:::stateBlock

    MainModel["main agent model 호출<br/><br/>model = init_chat_model(MODEL_ID)<br/><br/>system_prompt의 지시와<br/>현재 대화 컨텍스트를 바탕으로 응답 생성"]:::agentBlock

    Response["result['messages'][-1].content<br/><br/>현재 질문에 대한 assistant 응답"]:::stateBlock

    Save["갱신된 messages 상태를<br/>InMemorySaver checkpoint에 저장<br/><br/>다음 question의 invoke에서<br/>같은 thread_id로 다시 이어서 사용"]:::stateBlock

    Note["노트북 설명:<br/>요약은 오래된 정보의 핵심을 남길 수 있지만 손실 압축이다.<br/>요약용 모델 호출 비용과 요약 오류 가능성을 고려해야 한다."]:::noteBlock

    AgentCode == "1. Agent 구성" ==> Invoke
    Config == "2. 같은 thread_id 제공" ==> Invoke
    Invoke ==> LoadState
    LoadState ==> Append
    Append ==> Middleware
    Middleware ==> Trigger
    Trigger -- "아직 아님" --> NoSummary
    Trigger -- "도달" --> Split
    Split ==> SummaryCall
    SummaryCall ==> Rebuild
    NoSummary ==> MainModel
    Rebuild ==> MainModel
    MainModel ==> Response
    Response ==> Save
    Save -. "다음 invoke" .-> LoadState
    Note -.-> SummaryCall
