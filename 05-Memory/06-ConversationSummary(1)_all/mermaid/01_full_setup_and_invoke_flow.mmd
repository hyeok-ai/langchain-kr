graph TD
    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#555,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef configBlock fill:#1e1e1e,color:#9cdcfe,stroke:#4fc1ff,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef middlewareBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef agentBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:3px,text-align:left,font-family:monospace,font-size:15px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:3px,text-align:left,font-family:monospace,font-size:14px;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace,font-size:14px;
    classDef noteBlock fill:#fff8dc,color:#333,stroke:#d6b656,stroke-width:2px,text-align:left,font-size:14px;

    Imports["import os<br/><br/>from dotenv import load_dotenv<br/>from langchain.chat_models import init_chat_model<br/><br/>load_dotenv()"]:::codeBlock

    Model["# 다른 공급자를 쓸 때는 예: anthropic:claude-... 처럼 지정 가능<br/>MODEL_ID = os.getenv('CHAT_MODEL', 'openai:gpt-5.6-luna')<br/>model = init_chat_model(MODEL_ID)"]:::configBlock

    AgentImports["from langchain.agents import create_agent<br/>from langchain.agents.middleware import SummarizationMiddleware<br/>from langgraph.checkpoint.memory import InMemorySaver"]:::codeBlock

    Middleware["SummarizationMiddleware(<br/>　　model=model,<br/>　　trigger=('messages', 8),<br/>　　keep=('messages', 4),<br/>)<br/><br/>• 메시지 개수 8 기준으로 요약 trigger<br/>• 최근 메시지 4개는 그대로 유지<br/>• 요약에도 같은 model 객체 사용"]:::middlewareBlock

    Checkpointer["InMemorySaver()<br/><br/>대화 상태를 thread_id별 checkpoint로 보존"]:::middlewareBlock

    Agent["summary_agent = create_agent(<br/>　　model=model,<br/>　　tools=[],<br/>　　system_prompt=(<br/>　　　　'당신은 여행 상품 상담원입니다. 가격·포함 사항·취소 조건을 정확히 기억하고 '<br/>　　　　'모르는 내용은 추측하지 마세요.'<br/>　　),<br/>　　middleware=[<br/>　　　　SummarizationMiddleware(<br/>　　　　　　model=model,<br/>　　　　　　trigger=('messages', 8),<br/>　　　　　　keep=('messages', 4),<br/>　　　　)<br/>　　],<br/>　　checkpointer=InMemorySaver(),<br/>)"]:::agentBlock

    Config["config = {<br/>　　'configurable': {<br/>　　　　'thread_id': 'europe-package'<br/>　　}<br/>}"]:::configBlock

    Questions["questions = [<br/>　　'유럽 14박 15일 패키지의 기본 가격은 3,500유로라고 기억해 주세요.',<br/>　　'주요 방문지는 파리, 로마, 베를린, 취리히입니다.',<br/>　　'기본 여행자 보험이 포함되고, 비즈니스석 업그레이드는 1,200유로입니다.',<br/>　　'호텔은 4성급이며 매일 조식만 포함됩니다.',<br/>　　'예약금은 500유로이고 30일 전까지 취소하면 전액 환불됩니다.',<br/>　　'지금까지 알려드린 가격과 취소 조건을 정리해 주세요.',<br/>"]:::codeBlock

    Loop["for question in questions:<br/>　　result = summary_agent.invoke(<br/>　　　　{'messages': [<br/>　　　　　　{'role': 'user', 'content': question}<br/>　　　　]},<br/>　　　　config=config,<br/>　　)<br/>　　print(f'Q: {question}\\nA: {result[\'messages\'][-1].content}\\n')"]:::execBlock

    InvokeInternal["summary_agent.invoke(...) 실행 때마다<br/><br/>1) 같은 thread_id='europe-package'의 checkpoint 상태 사용<br/>2) 새 user message를 agent 입력으로 전달<br/>3) SummarizationMiddleware가 trigger 조건을 검사<br/>4) 필요하면 오래된 메시지를 요약하고 최근 메시지는 유지<br/>5) model이 응답 생성<br/>6) 갱신된 messages 상태를 checkpoint에 저장"]:::resultBlock

    Printed["출력<br/><br/>Q: 현재 question<br/>A: result['messages'][-1].content<br/><br/>이 과정을 questions의 6개 항목에 대해 반복"]:::resultBlock

    Note["노트북 설명의 핵심:<br/>단순 trimming과 달리 오래된 정보의 핵심을 요약으로 남긴다.<br/>대신 요약용 모델 호출 비용과 요약 오류 가능성이 있다."]:::noteBlock

    Imports == "1. 환경변수 로드 + 모델 API 준비" ==> Model
    AgentImports == "2. Agent / Middleware / Checkpointer 클래스 준비" ==> Agent
    Model == "3. model 인자로 재사용" ==> Agent
    Model == "요약용 model" ==> Middleware
    Middleware == "4. middleware=[...]" ==> Agent
    Checkpointer == "5. checkpointer=" ==> Agent
    Agent == "6. 완성된 summary_agent" ==> Loop
    Config == "7. invoke마다 동일 config 전달" ==> Loop
    Questions == "8. question을 하나씩 꺼냄" ==> Loop
    Loop ==> InvokeInternal
    InvokeInternal ==> Printed
    Note -.-> Middleware

    Middleware ~~~ Checkpointer
    Config ~~~ Questions
