graph TD

    classDef codeBlock fill:#1e1e1e,color:#d4d4d4,stroke:#444,stroke-width:2px,text-align:left,font-family:monospace;
    classDef funcBlock fill:#1e1e1e,color:#4ec9b0,stroke:#4ec9b0,stroke-width:2px,text-align:left,font-family:monospace;
    classDef graphBlock fill:#1e1e1e,color:#569cd6,stroke:#569cd6,stroke-width:2px,text-align:left,font-family:monospace,font-size:16px;
    classDef execBlock fill:#1e1e1e,color:#ce9178,stroke:#ce9178,stroke-width:2px,text-align:left,font-family:monospace;
    classDef resultBlock fill:#1e1e1e,color:#b5cea8,stroke:#6a9955,stroke-width:2px,text-align:left,font-family:monospace;
    classDef stateBlock fill:#1e1e1e,color:#c586c0,stroke:#c586c0,stroke-width:2px,text-align:left,font-family:monospace;

    TokenChat["token_chat<br/>└─ compiled StateGraph<br/>└─ InMemorySaver checkpointer"]:::graphBlock
    Config["config = {'configurable': {'thread_id': 'token-demo'}}"]:::stateBlock

    GetState["token_chat.get_state(config)"]:::execBlock
    Values[".values['messages']"]:::stateBlock
    Full["full_history =<br/>token_chat.get_state(config).values['messages']<br/><br/>→ checkpoint에 저장된 전체 메시지 이력"]:::resultBlock

    Slice["full_history[:-1]<br/>└─ 마지막 AI 응답을 제외<br/>└─ 마지막 model.invoke 직전 상태 재구성"]:::codeBlock

    Trim["context_used_for_last_call =<br/>trim_for_model(full_history[:-1])"]:::funcBlock

    Counts["print('저장된 전체 메시지 수:', len(full_history))<br/>print('마지막 모델 입력 메시지 수:', len(context_used_for_last_call))"]:::resultBlock

    TokenChat == "1. checkpointer에서 상태 조회" ==> GetState
    Config == "2. 동일한 thread_id 지정" ==> GetState
    GetState ==> Values
    Values == "3. messages 값 추출" ==> Full
    Full == "4. 마지막 AI 응답 제외" ==> Slice
    Slice == "5. 동일한 trimming 정책 재적용" ==> Trim
    Full -. "전체 이력 길이" .-> Counts
    Trim -. "실제 모델 컨텍스트 길이" .-> Counts
